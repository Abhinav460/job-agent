# Copy to .env (gitignored) and fill in locally. Never commit .env, and never
# paste these values into a chat, issue, or log.

# --- Personal data directory (outside the repo) ---
# Holds resume.tex, bullets.yaml, profile.yaml, secrets/, browser_profile/,
# checkpoints/, output/, screenshots/. See examples/ for the expected layout.
JOBAGENT_HOME=~/.jobagent

# --- Anthropic (required) ---
ANTHROPIC_API_KEY=
COORDINATOR_MODEL=claude-sonnet-5
WRITER_MODEL=claude-opus-5-5

# --- Gemini (optional, off by default) ---
GEMINI_ENABLED=false
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# --- Qdrant bullet bank (e.g. Docker on a home server over Tailscale) ---
QDRANT_URL=http://your-server.your-tailnet.ts.net:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=bullet_bank

# --- Ollama embeddings ---
OLLAMA_BASE_URL=http://your-server.your-tailnet.ts.net:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# --- Google Sheets tracker ---
# Spreadsheet ID from the sheet URL. Share the sheet with the service
# account's client_email. Key file defaults to $JOBAGENT_HOME/secrets/service_account.json
GOOGLE_SHEET_ID=
GOOGLE_SERVICE_ACCOUNT_FILE=

# --- LangSmith tracing (OFF unless you opt in; traces contain personal data) ---
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=job-agent

# --- Your identity, used ONLY to redact logs and to scan git history before
# publishing. Never written anywhere else. ---
JOBAGENT_OWNER_NAME=
JOBAGENT_OWNER_EMAIL=
JOBAGENT_OWNER_PHONE=

LOG_LEVEL=INFO
